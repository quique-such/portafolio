---
// Contact section
---

<section id="contact" style="padding:100px 0;background:#0b0b0b;position:relative;overflow:hidden;">
  <!-- Accent glow bottom-right -->
  <div class="pointer-events-none" style="position:absolute;bottom:-20%;right:-5%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(32,198,90,0.05) 0%,transparent 70%);" aria-hidden="true"></div>

  <div style="max-width:800px;margin:0 auto;padding:0 32px;text-align:center;position:relative;z-index:1;">

    <!-- Section title -->
    <div class="reveal" style="margin-bottom:0;">
      <p class="font-mono text-accent uppercase" style="font-size:11px;letter-spacing:0.2em;margin-bottom:10px;">// 05</p>
      <h2 class="text-text font-extrabold" style="font-size:clamp(28px,3.5vw,40px);letter-spacing:-0.02em;line-height:1.1;" data-i18n="contact.title">Contacto</h2>
      <div class="section-bar" style="margin-left:auto;margin-right:auto;"></div>
      <p class="text-muted" style="font-size:15px;line-height:1.7;margin-top:24px;margin-bottom:48px;" data-i18n="contact.tagline">¿Quieres ponerte en contacto? Escríbeme.</p>
    </div>

    <!-- Email CTA -->
    <div class="reveal reveal-delay-1" style="margin-bottom:24px;">
      <a href="mailto:quiquesuchandreu@gmail.com" class="email-cta" style="display:inline-flex;align-items:center;gap:12px;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
        </svg>
        quiquesuchandreu@gmail.com
      </a>
    </div>

    <!-- Social links -->
    <div class="reveal reveal-delay-2" style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;">
      <a href="https://linkedin.com/in/enrique-such-andreu" target="_blank" rel="noopener noreferrer" class="contact-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
          <rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>
        </svg>
        <span style="font-size:13px;font-weight:500;" data-i18n="contact.linkedin_label">LinkedIn</span>
      </a>
      <a href="https://github.com/quique-such" target="_blank" rel="noopener noreferrer" class="contact-link">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
        </svg>
        <span style="font-size:13px;font-weight:500;" data-i18n="contact.github_label">GitHub</span>
      </a>
    </div>

  </div>
</section>

<style>
  .email-cta {
    background: #20c65a;
    color: #000;
    font-weight: 700;
    font-size: 14px;
    padding: 16px 32px;
    border-radius: 10px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .email-cta:hover {
    background: #4ade80;
    transform: translateY(-2px);
  }
</style>
