---
import esData from '../i18n/es.json';
const projects = esData.projects.items;
---

<section id="projects" style="padding:100px 0;background:#0b0b0b;">
  <div style="max-width:1100px;margin:0 auto;padding:0 32px;">

    <!-- Section title -->
    <div class="reveal" style="margin-bottom:56px;">
      <p class="font-mono text-accent uppercase" style="font-size:11px;letter-spacing:0.2em;margin-bottom:10px;">// 01</p>
      <h2 class="text-text font-extrabold" style="font-size:clamp(28px,3.5vw,40px);letter-spacing:-0.02em;line-height:1.1;" data-i18n="projects.title">Proyectos destacados</h2>
      <div class="section-bar"></div>
    </div>

    <!-- Filters -->
    <div class="reveal" id="project-filters" style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:40px;">
      <button class="filter-btn active" data-filter="All">All</button>
      <button class="filter-btn" data-filter="Python">Python</button>
      <button class="filter-btn" data-filter="JavaScript">JavaScript</button>
      <button class="filter-btn" data-filter="Blender">Blender</button>
      <button class="filter-btn" data-filter="C#">C#</button>
    </div>

    <!-- Grid -->
    <div id="projects-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px;">
      {projects.map((project) => (
        <div
          class="reveal project-card"
          data-project-id={project.id}
          data-tags={JSON.stringify(project.tags)}
        >
          <div style="display:flex;justify-content:space-between;align-items:flex-start;">
            <span class="project-num font-mono" style="font-size:11px;color:#5a5a5a;letter-spacing:0.1em;">/{String(project.id).padStart(2,'0')}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3a3a3a" stroke-width="1.5" stroke-linecap="round">
              <line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/>
            </svg>
          </div>
          <h3 class="project-name text-text font-bold" style="font-size:15px;line-height:1.3;">{project.name}</h3>
          <p class="project-description text-muted" style="font-size:13px;line-height:1.65;flex:1;">{project.description}</p>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            {project.tags.map(tag => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .project-card {
    border: 1px solid #242424;
    border-radius: 12px;
    background: #161616;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    transition: border-color 0.2s, transform 0.2s, box-shadow 0.2s;
    cursor: default;
  }
  .project-card:hover {
    border-color: #20c65a;
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(32, 198, 90, 0.08);
  }
</style>

<script>
  // ─── Filter ────────────────────────────────────────────────────────────────
  const filterBtns = document.querySelectorAll('#project-filters .filter-btn');
  const cards = document.querySelectorAll('#projects-grid [data-project-id]');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.getAttribute('data-filter')!;
      cards.forEach(card => {
        const tags: string[] = JSON.parse(card.getAttribute('data-tags') || '[]');
        const show = filter === 'All' || tags.includes(filter);
        (card as HTMLElement).style.display = show ? '' : 'none';
      });
    });
  });

  // ─── i18n ──────────────────────────────────────────────────────────────────
  window.addEventListener('langchange', (e: Event) => {
    const { translations } = (e as CustomEvent).detail;
    const items = translations?.projects?.items;
    if (!Array.isArray(items)) return;
    items.forEach((project: { id: number; name: string; description: string }) => {
      const card = document.querySelector(`[data-project-id="${project.id}"]`);
      if (!card) return;
      const nameEl = card.querySelector('.project-name');
      const descEl = card.querySelector('.project-description');
      if (nameEl) nameEl.textContent = project.name;
      if (descEl) descEl.textContent = project.description;
    });
  });
</script>
